server {
    listen 8080;
    server_name _;

    root /var/www/intranet;
    index index.html;

access_log /var/log/nginx/intranet_access.log;
error_log /var/log/nginx/intranet_error.log;

auth_basic "Acceso Restringido a Intranet";
auth_basic_user_file /etc/nginx/seguridad/intranet.htpasswd;

    location / {
        try_files $uri $uri/ =404;
    }
}
