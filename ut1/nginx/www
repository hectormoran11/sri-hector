server {
    listen 80;
    server_name www.hector.test hector.test;

    root /var/www/www;
    index index.html index.php;

access_log /var/log/nginx/www_access.log;
error_log /var/log/nginx/www_error.log;

    location / {
        try_files $uri $uri/ =404;
    }

    location /admin/ {
        satisfy any;

        allow 192.168.154.134;
        allow 127.0.0.1;
        deny all;

    
        auth_basic "Area de Administracion";
        auth_basic_user_file /etc/nginx/seguridad/admin.htpasswd;

        try_files $uri $uri/ =404;
    }

    location /descargas/ {
        fancyindex on;
        fancyindex_localtime on;
        fancyindex_exact_size off;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }
}
